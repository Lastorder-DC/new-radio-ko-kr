# Site Config
SITE_URL=https://splatoon3.ink
ASSET_URL=https://assets.splatoon3.ink

# Load data from Splatoon3.ink during development
VITE_DATA_FROM=https://splatoon3.ink

# Nintendo API session tokens (configure at least one region)
NINTENDO_TOKEN_AP=
NINTENDO_TOKEN_US=
NINTENDO_TOKEN_EU=
NINTENDO_TOKEN_JP=

# nxapi client authentication (https://nxapi-auth.fancy.org.uk/oauth/clients)
NXAPI_CLIENT_ID=
NXAPI_SHARED_SECRET=
# Alternative: public client authentication (used when the pair above is unset)
NXAPI_AUTH_CLIENT_PUBLIC=

# User agent string
USER_AGENT=

# Sentry
SENTRY_DSN=

# Archive all data (can use a lot of disk space)
ARCHIVE_DATA=false

# Screenshots (choose cloudflare or browserless explicitly)
SCREENSHOT_PROVIDER=browserless

# Browserless (local development)
BROWSERLESS_ENDPOINT=ws://localhost:3000
SCREENSHOT_HOST=host.docker.internal
BROWSERLESS_CONCURRENT=2

# Cloudflare Browser Run Quick Actions (production)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RUN_API_TOKEN=

# S3 parameters
AWS_S3_ENDPOINT=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_ARCHIVE_BUCKET=
AWS_S3_PRIVATE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudflare R2 public data and images
R2_ENDPOINT=
R2_BUCKET=splatoon3-ink-assets
R2_PUBLIC_URL=https://assets.splatoon3.ink
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional JSON edge caching. Deploy and verify purging before enabling cache rules.
# Token permission: Zone > Cache Purge > Purge, restricted to splatoon3.ink.
CLOUDFLARE_CACHE_PURGE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_API_TOKEN=
CLOUDFLARE_CACHE_PURGE_HOSTS=splatoon3.ink,assets.splatoon3.ink,dev.splatoon3.ink

# Twitter API parameters
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN_KEY=
TWITTER_ACCESS_TOKEN_SECRET=

# Buffer Twitter (enabled when both values are set)
# Public JSON bot reuses Mastodon image URLs; legacy npm run social uses R2.
# Personal key scopes: accountRead, postsRead, postsWrite.
# Find the channel ID with: npm run social:buffer:channels (read-only).
BUFFER_API_KEY=
BUFFER_TWITTER_CHANNEL_ID=

# Social post language (ko-KR, en-US or ja-JP)
SOCIAL_LOCALE=ko-KR

# Mastodon API parameters
MASTODON_URL=
MASTODON_ACCESS_TOKEN=
MASTODON_VISIBILITY=unlisted

# Bluesky API parameters
BLUESKY_SERVICE=https://bsky.social
BLUESKY_IDENTIFIER=splatoon3.ink # Handle or email address
BLUESKY_PASSWORD=

# Japanese social accounts (Twitter via Buffer and Bluesky)
BUFFER_TWITTER_JP_CHANNEL_ID=
BLUESKY_JP_SERVICE=https://bsky.social
BLUESKY_JP_IDENTIFIER=
BLUESKY_JP_PASSWORD=

# Threads API parameters (https://developers.facebook.com/docs/threads)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Public JSON bot (compose.bot.yml; no Nintendo credentials needed)
PUBLIC_DATA_USER_AGENT=new-radio-ko-kr/1.0 (https://github.com/Lastorder-DC/new-radio-ko-kr)
# Generate once: openssl rand -hex 32
BROWSERLESS_TOKEN=
# Optional: pin the tested browser image digest here
BROWSERLESS_IMAGE=ghcr.io/browserless/chromium:latest
